# Sao chép file này thành .env và điền thông tin thật.
# Không commit file .env. Mật khẩu ứng dụng Gmail phải viết liền, không có khoảng trắng.

NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_FROM_EMAIL=your-email@gmail.com
NOTIFICATION_RETENTION_DAYS=90
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=replace-with-new-16-character-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true
