# Sao chép file này thành .env ở thư mục gốc dự án.
# Điền Gmail App Password thật vào SPRING_MAIL_PASSWORD.
# Không commit file .env vì có thông tin nhạy cảm.

APP_FRONTEND_BASE_URL=http://localhost:5173
APP_MAIL_ENABLED=true

# Gmail gửi email kích hoạt thành viên
APP_MAIL_FROM=your-email@gmail.com
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=replace-with-16-character-gmail-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true

# Notification service dùng chung SMTP nếu cần gửi email thông báo
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_FROM_EMAIL=your-email@gmail.com
NOTIFICATION_RETENTION_DAYS=90

# VNPAY sandbox
# Lấy trong trang quản trị/sandbox VNPAY: vnp_TmnCode và vnp_HashSecret.
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
VNPAY_TMN_CODE=replace-with-vnpay-sandbox-tmn-code
VNPAY_HASH_SECRET=replace-with-vnpay-sandbox-hash-secret

# Frontend media base URL for uploaded images
VITE_MEDIA_BASE_URL=http://localhost:18081
